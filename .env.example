# Copy to .env and adjust. Never commit the real .env file.

# Long random string - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database. Default (empty) = SQLite file in ./instance/resume_analyzer.db
# Render with persistent disk:  sqlite:////var/data/resume_analyzer.db
# MySQL (pip install PyMySQL):  mysql+pymysql://user:password@host:3306/resume_analyzer
DATABASE_URL=

# Where uploaded resumes are stored (Render persistent disk: /var/data/uploads)
UPLOAD_FOLDER=
# Keep the original uploaded file after extracting its text (true/false)
KEEP_UPLOADED_FILES=true

MAX_UPLOAD_MB=5
# Days before resumes/analyses are deleted automatically (0 = never)
RETENTION_DAYS=7

# Comma-separated origins allowed to call /api/* (only needed for a separately hosted frontend)
CORS_ORIGINS=

FLASK_DEBUG=0
PORT=5000
